{
  "name": "magebit/module-magento2-configurator",
  "description": "Keep Magento persistently configured using version-controlled files.",
  "type": "magento2-module",
  "license": "MIT",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.magento.com/"
    }
  ],
  "require": {
    "php": ">=8.1 <8.6",
    "symfony/yaml": "~6.0|~7.0",
    "firegento/fastsimpleimport": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "magento/magento-coding-standard": "*",
    "phpstan/phpstan": "^1.12",
    "bitexpert/phpstan-magento": "^0.30 || ^1.0",
    "phpmd/phpmd": "^2.15"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Magebit\\Configurator\\": ""
    }
  }
}
